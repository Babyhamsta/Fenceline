{
  "manifest_version": 3,
  "name": "Fenceline",
  "version": "1.3.4",
  "minimum_chrome_version": "121",
  "description": "Self-hosted, on-device CIPA content filtering for managed Chromebooks. Blocks on every network, logs blocked attempts only, costs nothing to run.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Fenceline",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/unload-guard.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/scan.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "declarativeNetRequest",
    "webNavigation",
    "webRequest",
    "scripting",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "storage": {
    "managed_schema": "policy/managed_schema.json"
  },
  "options_page": "report/report.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
